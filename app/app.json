{
  "expo": {
    "name": "little by little",
    "slug": "little-by-little",
    "scheme": "littlebylittle",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF8F2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.littlebylittle.app"
    },
    "android": {
      "package": "com.littlebylittle.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "little by little needs access to your photos so you can preserve them as memories.",
          "cameraPermission": "little by little needs your camera to capture a moment as it happens."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "little by little uses your microphone to record family conversations.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "little by little needs your camera to capture a moment as it happens.",
          "microphonePermission": "little by little uses your microphone to record family conversations.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-font"
    ]
  }
}
