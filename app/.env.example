# Copy to app/.env (gitignored). Expo inlines EXPO_PUBLIC_* at bundle time,
# so restart Metro (`npx expo start -c`) after changing any of them.

# Where the API is. Unset, the app guesses: localhost on the web, Metro's LAN
# host on a phone.
# EXPO_PUBLIC_API_URL=http://localhost:4000

# `dev` (default): sign in with an email, no password; the API must run
# AUTH_MODE=dev. `firebase`: email + password through Firebase Auth; the API
# must run AUTH_MODE=firebase with FIREBASE_PROJECT_ID set to the same project.
EXPO_PUBLIC_AUTH_MODE=dev

# Firebase web app config (Firebase console → Project settings → Your apps →
# Web app). Public identifiers, not secrets. Use the *dev* project locally.
# Required only when EXPO_PUBLIC_AUTH_MODE=firebase.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Development aid only: point Firebase Auth at a local emulator
# (`npx firebase-tools emulators:start --only auth --project demo-littlebylittle`)
# instead of a real project. Use with EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-littlebylittle
# and any non-empty values above; run the API with
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099. See README → Auth → Emailed links.
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
