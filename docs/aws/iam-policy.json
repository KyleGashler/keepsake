{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BucketLevel",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET"
    },
    {
      "Sid": "ReadAndCreateObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET/*"
    },
    {
      "Sid": "DeleteDerivatives",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET/*"
    },
    {
      "Sid": "NeverDeleteOriginals",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET/*/original.*"
    }
  ]
}
