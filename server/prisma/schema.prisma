// little by little data model.
//
// A Family is the tenancy boundary: every row that holds content hangs off one,
// and every query filters by familyId. People in a family are Person rows; a
// Person who can sign in is linked to a User through a FamilyMembership, which
// also carries the role (OWNER / CONTRIBUTOR / VIEWER). Children are Person rows
// and never Users. Invites bring new Users into a family.
//
// Photo Media rows point at objects in a storage provider (storageKey) and gain
// Derivatives — thumbnails, display renditions, waveforms. Video and audio live
// on Mux instead: a Media row links to a MuxAsset, which carries the playback
// id, poster, captions and transcript. Background work (Mux sync, narration,
// push) runs through the Job table.
// Subscription and DeviceToken back billing and push.
//
// Several columns are placeholders that later phases fill: Memory.palette and
// analysisStatus, Media.storageKey/sha256, Job payloads. The seeded demo family
// in src/seed.ts exercises the whole shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The three Story Pillars the Library is organized around.
enum Pillar {
  ARRIVAL_STORIES
  CHILD_PROFILES
  FAMILY_LIFE
}

enum PersonRole {
  PARENT
  CHILD
  GRANDPARENT
  RELATIVE
  COLLABORATOR
}

enum MediaType {
  PHOTO
  VIDEO
  AUDIO
}

/// What a member is allowed to do inside one family.
enum MembershipRole {
  OWNER
  CONTRIBUTOR
  VIEWER
}

/// Lifecycle of an uploaded object. Photos: init → UPLOADING, finalize →
/// READY. Video and audio are PROCESSING while Mux transcodes them, then READY
/// (playable) or FAILED (Mux couldn't decode the file).
enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

/// A rendition generated from an original. Generating one never touches the original.
enum DerivativeKind {
  THUMB
  DISPLAY
  POSTER
  WAVEFORM
}

/// Progress of the background analysis pass over a Memory.
enum AnalysisStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

/// Who wrote the narrative. Flips to HUMAN the moment a person edits it.
enum StorySource {
  HUMAN
  AI_DRAFT
}

/// Progress of speech-to-text (Mux generated captions) over one AUDIO or
/// VIDEO clip. Null on a Media row means transcription doesn't apply (photos,
/// placeholders).
enum TranscriptStatus {
  PENDING
  READY
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/// Highest-level container: the shared archive belonging to a household.
model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  people       Person[]
  collections  Collection[]
  memories     Memory[]
  updates      ActivityEvent[]
  prompts      CapturePrompt[]
  memberships  FamilyMembership[]
  invites      Invite[]
  subscription Subscription?
  pillarCovers PillarCover[]
  muxAssets    MuxAsset[]
}

/// An individual whose life is part of the family's story.
model Person {
  id          String     @id @default(cuid())
  familyId    String
  name        String
  role        PersonRole
  /// How this person is referred to inside the family ("Mom", "Grandpa").
  relation    String?
  birthDate   DateTime?
  /// Deterministic seed for the generated placeholder avatar.
  avatarSeed  String
  accentColor String     @default("#C97B5A")
  sortOrder   Int        @default(0)
  /// Set when this person can sign in. Children never have one — enforced in
  /// application code, not by the schema.
  userId      String?    @unique
  /// Storage key of an uploaded profile photo (a finalized upload in this
  /// family's prefix). Null falls back to the generated avatar.
  photoKey    String?
  createdAt   DateTime   @default(now())

  family        Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  collections   Collection[]
  createdMemory Memory[]            @relation("MemoryAuthor")
  appearsIn     MemoryParticipant[]
  events        ActivityEvent[]
  membership    FamilyMembership?
  invites       Invite[]

  @@index([familyId])
}

/// A curated group of related Memories, experienced through a Story Pillar.
model Collection {
  id          String  @id @default(cuid())
  familyId    String
  pillar      Pillar
  name        String
  description String?
  /// Child Profile / Arrival Story collections are scoped to one person.
  personId    String?
  isDefault   Boolean @default(true)
  sortOrder   Int     @default(0)
  coverSeed   String
  /// Template key for a child's default collections (`milestones`,
  /// `day_to_day`, …; see lib/child-collections.ts). Null for a family's own.
  kind        String?
  /// Opaque glyph key the client maps to an icon, and the disc's hex colour.
  icon        String  @default("star")
  color       String  @default("#123F45")

  family    Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person    Person?            @relation(fields: [personId], references: [id], onDelete: Cascade)
  memories  MemoryCollection[]
  createdAt DateTime           @default(now())

  /// One default of each kind per child, so ensureChildCollections can't
  /// double up under a race. Family collections (null person/kind) are exempt.
  @@unique([personId, kind])
  @@index([familyId, pillar])
  @@index([personId])
}

/// The foundational object: a single meaningful moment preserved by a family.
model Memory {
  id             String         @id @default(cuid())
  familyId       String
  title          String
  /// The written narrative. Families always retain editorial control.
  story          String?
  /// Written record of spoken audio. Filled from the clips' Media.transcript
  /// while empty; once a person types or edits it, the job never touches it.
  transcript     String?
  occurredAt     DateTime
  location       String?
  authorId       String?
  /// Deterministic seed for the generated hero image.
  heroSeed       String
  /// Drives Mosaic's aesthetic ordering (0-360). Stands in for palette analysis.
  paletteHue     Int            @default(30)
  brightness     Int            @default(50)
  /// Hex swatches pulled from the hero image by the analysis job.
  palette        String[]       @default([])
  analysisStatus AnalysisStatus @default(PENDING)
  storySource    StorySource    @default(HUMAN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  family       Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author       Person?             @relation("MemoryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  media        Media[]
  collections  MemoryCollection[]
  participants MemoryParticipant[]
  favorites    MemoryFavorite[]
  linksFrom    MemoryLink[]        @relation("MemoryLinkFrom")
  linksTo      MemoryLink[]        @relation("MemoryLinkTo")

  /// Generated tsvector over title/location/story/transcript (A weighted highest,
  /// D lowest), maintained by Postgres itself — see the memory_search_vector
  /// migration. Prisma can't model a GENERATED column, so this is Unsupported
  /// purely so `migrate diff` / `db pull` don't see drift; it's never read or
  /// written through the client. Query it with $queryRaw (see routes/search.ts).
  searchVector Unsupported("tsvector")?

  @@index([familyId, occurredAt])
}

/// Original assets attached to a Memory. Originals are never overwritten, and
/// never deleted by the app on its own: only a family deleting the memory, or
/// removing this photo or clip from it, deletes the row and purges its files
/// (the `media.purge` job — see lib/purge.ts). There is no trash.
model Media {
  id               String            @id @default(cuid())
  memoryId         String
  type             MediaType
  /// Either a generated placeholder path or an uploaded file path.
  url              String
  caption          String?
  width            Int               @default(1200)
  height           Int               @default(900)
  durationS        Int?
  sortOrder        Int               @default(0)
  isOriginal       Boolean           @default(true)
  /// Key of the original object in the storage provider. Null for the
  /// generated placeholders the demo family ships with, and for video and
  /// audio, which live on Mux (see `muxAssetId`).
  storageKey       String?
  mimeType         String?
  bytes            Int?
  /// Hex digest of the original, recorded at finalize when storage has no
  /// checksum of its own (local disk, emulators). Null when `checksum` is set.
  sha256           String?
  /// Storage's own full-object checksum, `<algorithm>:<base64>` — e.g.
  /// `crc64nvme:…`, which S3 computes for every upload. Recorded at finalize
  /// instead of reading the object back to hash it.
  checksum         String?
  status           MediaStatus       @default(READY)
  /// What Mux's captions heard in this clip, copied from its MuxAsset.
  /// Memory.transcript is the family's editable copy; this one is the
  /// machine's, kept per clip.
  transcript       String?
  transcriptStatus TranscriptStatus?
  /// The Mux upload/asset behind a VIDEO or AUDIO clip. Null for photos,
  /// placeholders and pre-Mux rows.
  muxAssetId       String?
  createdAt        DateTime          @default(now())

  memory      Memory       @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  muxAsset    MuxAsset?    @relation(fields: [muxAssetId], references: [id], onDelete: SetNull)
  derivatives Derivative[]

  @@index([memoryId])
  @@index([muxAssetId])
}

/// One Mux direct upload and the asset it becomes. Created by
/// `POST /api/media/init`; filled in by finalize, Mux's webhooks and the
/// `mux.sync` job, in whatever order they arrive. Every field is a fact Mux
/// reported, merged so a replayed or late event can't move it backwards, and
/// `status` is computed from them (see media-host/assets.ts). Linked Media
/// rows copy what they show from here. The Mux asset is the only copy of the
/// family's clip, so the app never deletes it on its own: only an explicit
/// family delete (the memory, or the clip removed from it) drops this row,
/// once no Media links to it, and purges the asset through `media.purge`.
model MuxAsset {
  id              String           @id @default(cuid())
  familyId        String
  uploadId        String           @unique
  assetId         String?          @unique
  /// The signed playback id. Every URL to the clip is a JWT over it.
  playbackId      String?
  /// AUDIO or VIDEO, from the type the upload was declared as. Audio isn't
  /// playable until its `audio.m4a` static rendition is.
  type            MediaType
  /// The declared type and size at init; Mux doesn't report either back.
  mimeType        String
  bytes           Int
  /// Computed: UPLOADING (no bytes yet), PROCESSING, READY (playable), FAILED.
  status          MediaStatus      @default(UPLOADING)
  /// Mux's direct-upload status: waiting, asset_created, errored, cancelled, timed_out.
  uploadStatus    String           @default("waiting")
  /// Mux's asset status: preparing, ready, errored. Null until there's an asset.
  assetStatus     String?
  /// The `audio.m4a` static rendition (AUDIO only): preparing, ready, errored, skipped.
  renditionStatus String?
  durationS       Int?
  width           Int?
  height          Int?
  /// The asset's primary audio track: what captions are generated from.
  /// Null on a ready asset means it has no sound.
  audioTrackId    String?
  /// The generated (`generated_vod`) text track the transcript is read from.
  captionTrackId  String?
  captionStatus   TranscriptStatus @default(PENDING)
  /// Plain text of the caption track, fetched by `mux.sync`.
  transcript      String?
  /// Why it failed, in Mux's words (or ours, when polling gave up).
  error           String?
  /// Set when `mux.sync` stopped polling without the asset settling.
  syncGaveUpAt    DateTime?
  /// Temporary master access (downloads, A17): preparing, ready, errored.
  /// Null when never asked for, or after Mux reports it deleted.
  masterStatus    String?
  /// The master MP4's download URL, once ready. Mux keeps it valid for 24h.
  masterUrl       String?
  /// When `masterUrl` stops working: 24h after we asked. Mux refuses a new
  /// request until then, so this is also when the next request can be made.
  masterExpiresAt DateTime?
  /// Last time a download request looked at Mux for the master's state;
  /// throttles that polling (webhooks usually answer first).
  masterCheckedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  family Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  media  Media[]

  @@index([familyId])
}

/// A generated rendition of a Media original: thumbnail, display size, video
/// poster frame, audio waveform. Safe to delete and regenerate.
model Derivative {
  id         String         @id @default(cuid())
  mediaId    String
  kind       DerivativeKind
  storageKey String
  width      Int?
  height     Int?
  mimeType   String
  createdAt  DateTime       @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, kind])
}

model MemoryCollection {
  memoryId     String
  collectionId String

  memory     Memory     @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([memoryId, collectionId])
  @@index([collectionId])
}

model MemoryParticipant {
  memoryId String
  personId String

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([memoryId, personId])
  @@index([personId])
}

/// Journal-style "Family Updates" feed. Not social media notifications.
model ActivityEvent {
  id        String   @id @default(cuid())
  familyId  String
  actorId   String?
  kind      String
  message   String
  createdAt DateTime @default(now())

  family Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actor  Person? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([familyId, createdAt])
}

/// "Today's Moment to Capture". Hand-authored in v0; AI-generated later.
model CapturePrompt {
  id        String  @id @default(cuid())
  familyId  String
  text      String
  subtitle  String?
  imageSeed String
  sortOrder Int     @default(0)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

/// Someone who can sign in. Identity lives with the auth provider; this row is
/// the local mirror, keyed by the provider's subject id.
model User {
  id             String   @id @default(cuid())
  /// Provider subject, e.g. "firebase:abc123" or "dev:ali@example.com".
  authProviderId String   @unique
  email          String   @unique
  displayName    String
  createdAt      DateTime @default(now())

  memberships  FamilyMembership[]
  invitesSent  Invite[]           @relation("InviteInvitedBy")
  invitesTaken Invite[]           @relation("InviteAcceptedBy")
  deviceTokens DeviceToken[]
  person       Person?
  favorites    MemoryFavorite[]
}

/// A User's seat in one Family, with their role and (optionally) the Person
/// row that represents them in the archive.
model FamilyMembership {
  userId    String
  familyId  String
  role      MembershipRole
  /// The Person this member appears as inside the family, if any.
  personId  String?        @unique
  createdAt DateTime       @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@id([userId, familyId])
  @@index([familyId])
}

/// An invitation to join a family: a single-use link, optionally also emailed.
/// Any verified account may accept it — it is not bound to `email`. Pending
/// means not accepted, not revoked and not past `expiresAt`.
model Invite {
  id           String         @id @default(cuid())
  familyId     String
  /// Where the link was also emailed, if anywhere. Informational only.
  email        String?
  role         MembershipRole
  /// 256 random bits, base64url. Possessing it is the whole credential.
  token        String         @unique
  /// The existing (unlinked, non-CHILD) Person this invite is for. Accepting
  /// links them to the new membership; null means accept creates a Person.
  personId     String?
  /// For "someone new": the name the owner typed, used for the Person that
  /// accept creates. Null falls back to the account's display name.
  name         String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  invitedById  String
  createdAt    DateTime       @default(now())

  family     Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User?   @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  person     Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([personId])
}

/// Durable background work. Claimed with FOR UPDATE SKIP LOCKED; retried with
/// backoff until maxAttempts.
model Job {
  id          String    @id @default(cuid())
  /// Handler key, e.g. "media.derive", "ai.narrate".
  type        String
  payload     Json
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([type])
}

/// A push target for one user's device.
model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Billing state for a family, mirrored from the store or payment processor.
model Subscription {
  id               String    @id @default(cuid())
  familyId         String    @unique
  /// "revenuecat", "stripe", …
  provider         String
  externalId       String?
  status           String
  plan             String
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

/// A family's own cover photo for one Library pillar card. Absent means the
/// generated default.
model PillarCover {
  familyId   String
  pillar     Pillar
  /// A finalized upload in this family's prefix.
  storageKey String
  updatedAt  DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([familyId, pillar])
}

/// One signed-in user's favourite. Per user, not per family.
model MemoryFavorite {
  userId    String
  memoryId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@id([userId, memoryId])
  @@index([memoryId])
}

/// A manual "related memory". Undirected, so stored once with the smaller id
/// in `memoryId`. Both memories belong to the same family — checked on write.
model MemoryLink {
  memoryId  String
  linkedId  String
  createdAt DateTime @default(now())

  memory Memory @relation("MemoryLinkFrom", fields: [memoryId], references: [id], onDelete: Cascade)
  linked Memory @relation("MemoryLinkTo", fields: [linkedId], references: [id], onDelete: Cascade)

  @@id([memoryId, linkedId])
  @@index([linkedId])
}
