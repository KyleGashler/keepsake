{
  "name": "keepsake-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "storage:copy-to-s3": "tsx src/scripts/copy-local-to-s3.ts",
    "storage:s3-setup": "tsx src/scripts/s3-emulator-setup.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@mux/mux-node": "^15.5.0",
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.0.2",
    "helmet": "^8.3.0",
    "image-size": "^2.0.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
